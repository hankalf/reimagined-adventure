generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  HR
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ItemType {
  PRODUCT
  CUSTOM
}

enum CampaignItemStatus {
  AVAILABLE
  OUT_OF_STOCK
}

enum SelectionStatus {
  SELECTED
  NEEDS_REPICK
  ORDERED
  RECEIVED
  COLLECTED
}

enum EmailStatus {
  SENT
  FAILED
  LOGGED
}

enum ActorType {
  ADMIN
  EMPLOYEE
  SYSTEM
}

model AdminUser {
  id                 String    @id @default(cuid())
  /// Login name (case-insensitive). Email is optional and only used for password-reset links.
  username           String    @unique
  email              String?   @unique
  name               String
  passwordHash       String?
  role               AdminRole @default(ADMIN)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Employee {
  id             String             @id @default(cuid())
  employeeNumber String             @unique
  firstName      String
  lastName       String
  department     String?
  /// Optional; used only for "your gift is ready" notifications when SMTP is configured.
  email          String?
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  campaigns      CampaignEmployee[]
  selections     Selection[]
}

model Campaign {
  id                      String         @id @default(cuid())
  slug                    String         @unique
  name                    String
  status                  CampaignStatus @default(DRAFT)
  opensAt                 DateTime?
  closesAt                DateTime?
  requireLastName         Boolean        @default(true)
  allEmployeesEligible    Boolean        @default(true)
  allowChangeUntilOrdered Boolean        @default(true)
  /// Hours after an employee's first pick during which they may still change it. Null = until HR orders.
  changeWindowHours       Int?           @default(4)
  showSoldOutItems        Boolean        @default(true)
  hrEmails                String[]       @default([])

  // Content (English + optional Spanish)
  welcomeHeadline      String  @default("Choose your gift")
  welcomeHeadlineEs    String?
  welcomeMessage       String  @default("")
  welcomeMessageEs     String?
  pickupInstructions   String  @default("")
  pickupInstructionsEs String?
  leadershipMessage    String?
  leadershipMessageEs  String?
  leadershipName       String?

  // Branding
  logoImageId  String?
  heroImageId  String?
  primaryColor String  @default("#1d4ed8")
  accentColor  String  @default("#f59e0b")
  companyName  String?

  // Budget
  totalBudget           Decimal? @db.Decimal(12, 2)
  defaultEmployeeBudget Decimal? @db.Decimal(12, 2)
  hideItemsOverBudget   Boolean  @default(false)
  /// Employees never see item prices; this only controls the "Your gift budget: $X" line.
  showBudgetToEmployees Boolean  @default(false)
  currency              String   @default("USD")

  /// Landing page extras
  videoUrl                  String?
  showPickCount             Boolean @default(true)
  notifyEmployeesOnReceived Boolean @default(false)

  // Employee page look: background (pattern / gradient / uploaded image), text contrast, font, card style
  bgPattern  String  @default("none")
  bgColor    String  @default("#f8fafc")
  bgColor2   String  @default("#e2e8f0")
  bgImageId  String?
  bgOverlay  Int     @default(35)
  textMode   String  @default("auto")
  fontStyle  String  @default("modern")
  cardStyle  String  @default("solid")

  // Holiday mascots: master switch; the mascots themselves are in CampaignMascot
  mascotEnabled     Boolean @default(false)

  // Integrations
  feedToken     String    @unique @default(cuid())
  digestEnabled Boolean   @default(false)
  lastHrEmailAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees  CampaignEmployee[]
  items      CampaignItem[]
  selections Selection[]
  emails     EmailLog[]
  mascots    CampaignMascot[]
}

/// A dancing holiday character wearing an uploaded face. A campaign can have several, each placed on the
/// employee home (landing) page, the thank-you page and/or the printed poster.
model CampaignMascot {
  id            String   @id @default(cuid())
  campaignId    String
  /// elf | santa | snowman | reindeer | gingerbread | banana | pineapple | strawberry
  kind          String   @default("elf")
  imageId       String?
  caption       String?
  captionEs     String?
  faceZoom      Int      @default(100)
  faceOffsetX   Int      @default(0)
  faceOffsetY   Int      @default(0)
  faceRotate    Int      @default(0)
  faceFlip      Boolean  @default(false)
  showOnLanding Boolean  @default(true)
  showOnDone    Boolean  @default(false)
  showOnPoster  Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
}

model CampaignEmployee {
  campaignId     String
  employeeId     String
  budgetOverride Decimal? @db.Decimal(12, 2)
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([campaignId, employeeId])
}

model Item {
  id              String         @id @default(cuid())
  type            ItemType       @default(PRODUCT)
  name            String
  nameEs          String?
  description     String         @default("")
  descriptionEs   String?
  category        String?
  imageId         String?
  imageUrl        String?
  productUrl      String?
  asin            String?
  sku             String?
  unitCost        Decimal?       @db.Decimal(12, 2)
  fulfillmentNote String?
  option1Label    String?
  option1Values   String[]       @default([])
  option2Label    String?
  option2Values   String[]       @default([])
  /// Thumbnail framing: "contain" shows the whole photo in the square, "cover" fills it; zoom 100-250; focal point in %.
  thumbFit        String         @default("contain")
  thumbZoom       Int            @default(100)
  thumbFocusX     Int            @default(50)
  thumbFocusY     Int            @default(50)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  campaigns       CampaignItem[]
  selections      Selection[]
  images          ItemImage[]
  priceHistory    ItemPriceHistory[]
}

/// Every change to a gift's unit cost: edited in the catalog, imported, or corrected by HR when placing the order.
model ItemPriceHistory {
  id            String   @id @default(cuid())
  itemId        String
  campaignId    String?
  oldPrice      Decimal? @db.Decimal(12, 2)
  newPrice      Decimal  @db.Decimal(12, 2)
  source        String
  note          String?
  changedById   String?
  changedByName String?
  createdAt     DateTime @default(now())
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

/// Extra photos for a gift. `option1Value` ties a photo to a value of the first option group (e.g. Color: Red),
/// so the employee sees that photo when they pick the colour; null = general gallery photo.
model ItemImage {
  id           String   @id @default(cuid())
  itemId       String
  imageId      String
  option1Value String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, option1Value])
}

model CampaignItem {
  campaignId       String
  itemId           String
  sortOrder        Int                @default(0)
  status           CampaignItemStatus @default(AVAILABLE)
  stockLimit       Int?
  unitCostOverride Decimal?           @db.Decimal(12, 2)
  /// Option values offered in this campaign. Empty = every catalog value.
  enabledOption1Values String[]       @default([])
  enabledOption2Values String[]       @default([])
  campaign         Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  item             Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([campaignId, itemId])
}

model Selection {
  id               String          @id @default(cuid())
  campaignId       String
  employeeId       String
  itemId           String
  option1Value     String?
  option2Value     String?
  confirmationCode String          @unique
  costAtSelection  Decimal?        @db.Decimal(12, 2)
  status           SelectionStatus @default(SELECTED)
  language         String          @default("en")
  selectedAt       DateTime        @default(now())
  /// Start of the change window: the first pick (restarts when HR forces a re-pick). selectedAt moves on every change.
  firstSelectedAt  DateTime        @default(now())
  orderedAt        DateTime?
  receivedAt       DateTime?
  collectedAt      DateTime?
  notes            String?
  updatedAt        DateTime        @updatedAt
  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  item             Item            @relation(fields: [itemId], references: [id])

  @@unique([campaignId, employeeId])
  @@index([campaignId, status])
  @@index([campaignId, itemId])
}

model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  thumb     Bytes
  width     Int
  height    Int
  createdAt DateTime @default(now())
}

model EmailLog {
  id          String      @id @default(cuid())
  campaignId  String?
  to          String[]
  subject     String
  status      EmailStatus
  error       String?
  body        String
  attachments String[]    @default([])
  sentAt      DateTime    @default(now())
  campaign    Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId, sentAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
}

model Setting {
  key   String @id
  value String
}
