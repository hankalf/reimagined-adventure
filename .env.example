# --- Required ---
# Railway Postgres plugin sets this automatically when you add the database and reference it.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Long random string used to sign admin and employee session cookies. `openssl rand -hex 32`
SESSION_SECRET="replace-with-a-long-random-string"
# Public URL of the deployed app (no trailing slash). Used in QR codes and email links.
APP_URL="https://your-app.up.railway.app"

# --- First admin (created on first start if no admin users exist) ---
ADMIN_EMAIL="hr@yourcompany.com"
ADMIN_PASSWORD="choose-a-strong-password"

# --- Email ---
# "console" records emails in the admin Email log without sending (good for testing).
# "smtp" sends through the SMTP server below (Office 365, Gmail, Resend, SendGrid, Postmark...).
EMAIL_TRANSPORT="console"
EMAIL_FROM="Gift Portal <no-reply@yourcompany.com>"
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- Optional ---
# Shared secret for the scheduled digest endpoint (/api/cron/digest). Set it and point a Railway cron at the URL.
CRON_SECRET=""
